# Copia a .env para desarrollo local. El .env real nunca se versiona.
# En Heroku estas variables se fijan con `heroku config:set`, no en archivos.

ANTHROPIC_API_KEY=sk-ant-...
KARIN_MODELO=claude-sonnet-5
KARIN_DATABASE_URL=sqlite+pysqlite:///./karin_dev.db

# Login de demostración. Las contraseñas se entregan al profesor por la
# plataforma del curso, nunca por el repositorio.
# Contraseña del usuario inspector_demo (la variable conserva su nombre histórico).
KARIN_DEMO_PASSWORD_ANALISTA=cambiame
KARIN_DEMO_PASSWORD_SUPERVISOR=cambiame
KARIN_SESSION_SECRET=cambiame-cadena-larga-aleatoria

# Protección de presupuesto de la demo (complementa el límite de la consola).
KARIN_TOPE_LLAMADAS_DIA=200
KARIN_TOPE_USD_DIA=3.0
